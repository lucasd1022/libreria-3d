# Copiá este archivo como .env y completá los valores.
PORT=3000
NODE_ENV=development

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/libreria.sqlite

# Clave para firmar la sesión (cambiala por una cadena larga y aleatoria)
SESSION_SECRET=cambiar-esta-clave

# Credenciales del panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Datos de la tienda
TIENDA_NOMBRE=Librería 3D
TIENDA_EMAIL=contacto@ejemplo.com
TIENDA_WHATSAPP=5490000000000
