@{
    ViewData["Title"] = "Carrito";
    DetalleCarrito carrito = ViewBag.Carrito;
}

<div class="contenedor seccion">
    <h1 class="titulo">Tu carrito</h1>

    @if (carrito.EstaVacio)
    {
        <div class="vacio">
            <h2>Tu carrito está vacío</h2>
            <p>Buscá lo que necesitás en el catálogo y tocá "Agregar".</p>
            <a class="boton" asp-controller="Productos" asp-action="Index">Ver el catálogo</a>
        </div>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th><span class="solo-lectores">Acciones</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var linea in carrito.Lineas)
                    {
                        <tr>
                            <td><a asp-controller="Productos" asp-action="Detalle" asp-route-id="@linea.Producto.ID">@linea.Producto.Nombre</a></td>
                            <td>@Vistas.Precio(linea.Producto.Precio)</td>
                            <td>
                                <form class="fila-formulario" asp-controller="Carrito" asp-action="Actualizar" asp-route-id="@linea.Producto.ID" method="post">
                                    <label class="solo-lectores" for="cantidad-@linea.Producto.ID">Cantidad de @linea.Producto.Nombre</label>
                                    <input class="campo campo-cantidad" id="cantidad-@linea.Producto.ID" name="cantidad" type="number" value="@linea.Cantidad" min="0" max="@linea.Producto.Stock">
                                    <button class="boton-link" type="submit">Actualizar</button>
                                </form>
                            </td>
                            <td>@Vistas.Precio(linea.Subtotal)</td>
                            <td>
                                <form asp-controller="Carrito" asp-action="Quitar" asp-route-id="@linea.Producto.ID" method="post">
                                    <button class="boton-link boton-link-peligro" type="submit">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="3">Total</th><th colspan="2">@Vistas.Precio(carrito.Total)</th></tr>
                </tfoot>
            </table>
        </div>

        <div class="acciones">
            <a class="boton boton-borde" asp-controller="Productos" asp-action="Index">Seguir comprando</a>
            <a class="boton" asp-controller="Pedidos" asp-action="Checkout">Finalizar compra</a>
        </div>
    }
</div>
