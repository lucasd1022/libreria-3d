@{
    ViewData["Title"] = "El local";
}

<div class="contenedor seccion">
    <h1 class="titulo">Visitanos en el local</h1>
    <p class="texto-suave">Podés comprar acá en la página y retirarlo sin cargo, o venir a vernos.</p>

    <div class="grilla grilla-5-7">
        <div class="tarjeta">
            <partial name="_DatosLocal" />
        </div>
        <iframe class="marco-incrustado" src="@Tienda.MapaIncrustado" title="Mapa con la ubicación de @Tienda.Nombre" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</div>
