@{
    ViewData["Title"] = "Contacto";
}

<div class="contenedor seccion angosto">
    <h1 class="titulo">Contacto</h1>
    <div class="tarjeta">
        <p>¿Tenés una consulta o querés hacer un pedido mayorista? Escribinos.</p>
        <ul class="lista-datos">
            @if (!string.IsNullOrEmpty(Tienda.Email))
            {
                <li><strong>Email:</strong> <a href="mailto:@Tienda.Email">@Tienda.Email</a></li>
            }
            @if (!string.IsNullOrEmpty(Tienda.WhatsApp))
            {
                <li><strong>WhatsApp:</strong> <a href="https://wa.me/@Tienda.WhatsApp" target="_blank" rel="noopener">Mandanos un mensaje</a></li>
            }
        </ul>
    </div>
</div>
