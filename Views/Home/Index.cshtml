@{
    ViewData["Title"] = "";
}

<section class="portada">
    <div class="contenedor">
        <h1 class="titulo titulo-portada">Comprá online y retiralo en @Tienda.Nombre</h1>
        <p>@Tienda.Descripcion</p>
        <a class="boton boton-acento" asp-controller="Productos" asp-action="Index">Ver los productos</a>
    </div>
</section>

<section class="beneficios">
    <div class="contenedor beneficios-grilla">
        <div>
            <strong>Retiro sin cargo</strong>
            <span>En @Tienda.DireccionCompleta</span>
        </div>
        @if (Tienda.HaceEnvios)
        {
            <div>
                <strong>Envío a domicilio</strong>
                <span>@(string.IsNullOrEmpty(Tienda.ZonaEnvio) ? "" : Tienda.ZonaEnvio + " · ")@Tienda.TextoCostoEnvio</span>
            </div>
        }
        @if (Tienda.Horarios.Length > 0)
        {
            <div>
                <strong>Horarios del local</strong>
                <span>@string.Join(" · ", Tienda.Horarios)</span>
            </div>
        }
    </div>
</section>

<div class="contenedor seccion">
    <h2 class="subtitulo">Categorías</h2>
    <div class="etiquetas">
        @foreach (Categoria categoria in ViewBag.Categorias)
        {
            <a class="etiqueta etiqueta-link" asp-controller="Productos" asp-action="Index" asp-route-categoria="@categoria.ID">@categoria.Nombre (@categoria.CantidadProductos)</a>
        }
    </div>

    <h2 class="subtitulo">Lo último que llegó</h2>
    @if (ViewBag.Nuevos.Count == 0)
    {
        <div class="vacio">
            <h3>Todavía no hay productos</h3>
            <p>Cargalos desde el panel de administración.</p>
        </div>
    }
    else
    {
        <div class="grilla-productos">
            @foreach (Producto producto in ViewBag.Nuevos)
            {
                <partial name="_ProductoTarjeta" model="producto" />
            }
        </div>
    }
</div>

<section class="contenedor seccion">
    <div class="tarjeta visitanos">
        <div>
            <h2 class="subtitulo">Visitanos</h2>
            <partial name="_DatosLocal" />
        </div>
        <a class="boton boton-borde" asp-controller="Home" asp-action="Contacto">Ver el mapa</a>
    </div>
</section>
