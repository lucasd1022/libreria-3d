@{
    ViewData["Title"] = "";
}

<section class="banda-oscura">
    <div class="contenedor">
        <h1 class="titulo titulo-grande">Comprá online y retiralo en @Tienda.Nombre</h1>
        <p>@Tienda.Descripcion</p>
        <a class="boton boton-acento" asp-controller="Productos" asp-action="Index">Ver los productos</a>
    </div>
</section>

<section class="banda-clara">
    <div class="contenedor grilla-auto">
        <div class="pila acento-lateral">
            <strong class="texto-oscuro">Retiro sin cargo</strong>
            <span class="texto-suave">En @Tienda.DireccionCompleta</span>
        </div>
        @if (Tienda.HaceEnvios)
        {
            <div class="pila acento-lateral">
                <strong class="texto-oscuro">Envío a domicilio</strong>
                <span class="texto-suave">@(string.IsNullOrEmpty(Tienda.ZonaEnvio) ? "" : Tienda.ZonaEnvio + " · ")@Tienda.TextoCostoEnvio</span>
            </div>
        }
        @if (Tienda.Horarios.Length > 0)
        {
            <div class="pila acento-lateral">
                <strong class="texto-oscuro">Horarios del local</strong>
                <span class="texto-suave">@string.Join(" · ", Tienda.Horarios)</span>
            </div>
        }
    </div>
</section>

<div class="contenedor seccion">
    <h2 class="subtitulo">Categorías</h2>
    <div class="fila-envuelta">
        @foreach (Categoria categoria in ViewBag.Categorias)
        {
            <a class="etiqueta etiqueta-boton" asp-controller="Productos" asp-action="Index" asp-route-categoria="@categoria.ID">@categoria.Nombre (@categoria.CantidadProductos)</a>
        }
    </div>

    <h2 class="subtitulo">Lo último que llegó</h2>
    @if (ViewBag.Nuevos.Count == 0)
    {
        <div class="recuadro-punteado">
            <h3>Todavía no hay productos</h3>
            <p>Cargalos desde el panel de administración.</p>
        </div>
    }
    else
    {
        <div class="grilla-tarjetas">
            @foreach (Producto producto in ViewBag.Nuevos)
            {
                <partial name="_ProductoTarjeta" model="producto" />
            }
        </div>
    }
</div>

<section class="contenedor seccion">
    <div class="tarjeta fila-separada">
        <div>
            <h2 class="subtitulo">Visitanos</h2>
            <partial name="_DatosLocal" />
        </div>
        <a class="boton boton-borde" asp-controller="Home" asp-action="Contacto">Ver el mapa</a>
    </div>
</section>
