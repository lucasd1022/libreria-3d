@{
    Pedido pedido = ViewBag.Pedido;
    ViewData["Title"] = $"Pedido #{pedido.ID}";
}

<div class="contenedor seccion">
    <partial name="_PanelMenu" />
    <div class="fila-separada">
        <div>
            <h1 class="titulo">Pedido #@pedido.ID</h1>
            <p class="texto-suave">@Vistas.Fecha(pedido.Fecha) · <span class="etiqueta @Vistas.ClaseEstado(pedido.Estado)">@pedido.Estado</span></p>
        </div>
        <a class="boton boton-borde" asp-controller="Panel" asp-action="Pedidos">Volver a pedidos</a>
    </div>

    <div class="grilla grilla-5-7">
        <div>
            <div class="tarjeta">
                <h2 class="tarjeta-subtitulo">Cliente</h2>
                <ul class="lista-renglones">
                    <li><strong>@pedido.Nombre</strong></li>
                    <li><a href="mailto:@pedido.Email">@pedido.Email</a></li>
                    @if (!string.IsNullOrEmpty(pedido.Telefono)) { <li>Teléfono: <a href="tel:@pedido.Telefono.Replace(" ", "")">@pedido.Telefono</a></li> }
                </ul>
                <h2 class="tarjeta-subtitulo">@pedido.TextoEntrega</h2>
                @if (pedido.EsEnvio)
                {
                    <p>@pedido.DireccionEnvio</p>
                }
                else
                {
                    <p class="texto-suave">Lo retira en el local. Pasalo a "@Pedido.ListoParaRetirar" cuando esté preparado.</p>
                }
                @if (!string.IsNullOrEmpty(pedido.Notas))
                {
                    <p class="texto-con-saltos"><strong>Notas:</strong> @pedido.Notas</p>
                }
            </div>
            <div class="tarjeta">
                <h2 class="tarjeta-subtitulo">Estado</h2>
                <form class="fila" asp-controller="Panel" asp-action="CambiarEstado" asp-route-id="@pedido.ID" method="post">
                    <label class="solo-lectores" for="estado">Estado</label>
                    <select class="campo" id="estado" name="estado">
                        @foreach (var estado in Pedido.EstadosPara(pedido.Forma_Entrega))
                        {
                            <option value="@estado" selected="@(pedido.Estado == estado)">@estado</option>
                        }
                    </select>
                    <button class="boton" type="submit">Guardar</button>
                </form>
            </div>
        </div>
        <div>
            <div class="tarjeta">
                <h2 class="tarjeta-subtitulo">Productos</h2>
                <table class="tabla">
                    <thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var item in pedido.Items)
                        {
                            <tr><td>@item.Nombre</td><td>@Vistas.Precio(item.Precio_Unitario)</td><td>@item.Cantidad</td><td>@Vistas.Precio(item.Subtotal)</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (pedido.EsEnvio)
                        {
                            <tr><td colspan="3">Subtotal</td><td>@Vistas.Precio(pedido.Subtotal)</td></tr>
                            <tr><td colspan="3">Envío</td><td>@(pedido.Costo_Envio == 0 ? "Gratis" : Vistas.Precio(pedido.Costo_Envio))</td></tr>
                        }
                        <tr><th colspan="3">Total</th><th>@Vistas.Precio(pedido.Total)</th></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
