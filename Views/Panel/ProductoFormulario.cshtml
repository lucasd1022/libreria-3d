@{
    ProductoViewModel datos = ViewBag.Formulario;
    int? id = ViewBag.IDProducto;
    ViewData["Title"] = id == null ? "Nuevo producto" : "Editar producto";
}

<div class="contenedor seccion contenedor-angosto">
    <partial name="_PanelMenu" />
    <h1 class="titulo">@ViewData["Title"]</h1>

    <partial name="_ErroresFormulario" />

    <form class="formulario tarjeta" asp-controller="Panel" asp-action="@(id == null ? "NuevoProducto" : "EditarProducto")" asp-route-id="@id" method="post" enctype="multipart/form-data">
        <div class="fila-campo @Html.ClaseError("Codigo")">
            <label class="campo-titulo" for="Codigo">Código <span class="texto-suave">(interno o de barras)</span></label>
            <input class="campo" id="Codigo" name="Codigo" value="@datos.Codigo" maxlength="40" pattern="[A-Za-z0-9._\-]+" autocomplete="off">
            <p class="error-texto">@Html.MensajeError("Codigo", "Usá solo letras, números, guiones o puntos")</p>
        </div>
        <div class="fila-campo @Html.ClaseError("Nombre")">
            <label class="campo-titulo" for="Nombre">Nombre</label>
            <input class="campo" id="Nombre" name="Nombre" value="@datos.Nombre" maxlength="120" required>
            <p class="error-texto">@Html.MensajeError("Nombre", "Completá el nombre")</p>
        </div>
        <div class="fila-campo @Html.ClaseError("Descripcion")">
            <label class="campo-titulo" for="Descripcion">Descripción</label>
            <textarea class="campo" id="Descripcion" name="Descripcion" rows="4" maxlength="1000">@datos.Descripcion</textarea>
            <p class="error-texto">@Html.MensajeError("Descripcion", "Usá hasta 1000 caracteres")</p>
        </div>
        <div class="grilla grilla-2 grilla-siempre">
            <div>
                <div class="fila-campo @Html.ClaseError("Precio")">
                    <label class="campo-titulo" for="Precio">Precio (ARS)</label>
                    <input class="campo" id="Precio" name="Precio" value="@datos.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" step="0.01" required>
                    <p class="error-texto">@Html.MensajeError("Precio", "El precio tiene que ser 0 o más")</p>
                </div>
            </div>
            <div>
                <div class="fila-campo @Html.ClaseError("Stock")">
                    <label class="campo-titulo" for="Stock">Stock</label>
                    <input class="campo" id="Stock" name="Stock" value="@datos.Stock" type="number" min="0" step="1" required>
                    <p class="error-texto">@Html.MensajeError("Stock", "El stock tiene que ser 0 o más")</p>
                </div>
            </div>
        </div>
        <div class="fila-campo">
            <label class="campo-titulo" for="IDCategoria">Categoría</label>
            <select class="campo" id="IDCategoria" name="IDCategoria">
                <option value="">Sin categoría</option>
                @foreach (Categoria categoria in ViewBag.Categorias)
                {
                    <option value="@categoria.ID" selected="@(datos.IDCategoria == categoria.ID)">@categoria.Nombre</option>
                }
            </select>
        </div>
        <div class="fila-campo @Html.ClaseError("Foto")">
            <label class="campo-titulo" for="foto">Foto <span class="texto-suave">(JPG, PNG o WEBP, hasta 5 MB)</span></label>
            @if (!string.IsNullOrEmpty(datos.Imagen))
            {
                <div class="fila espacio-abajo">
                    <img class="miniatura" src="@datos.Imagen" alt="Foto actual">
                    <label class="casilla"><input name="quitarFoto" value="true" type="checkbox"> Quitar la foto</label>
                </div>
            }
            <input class="campo" id="foto" name="foto" type="file" accept=".jpg,.jpeg,.png,.webp">
            <p class="error-texto">@Html.MensajeError("Foto", "Subí una foto JPG, PNG o WEBP")</p>
        </div>
        <label class="casilla">
            <input id="Activo" name="Activo" value="true" checked="@datos.Activo" type="checkbox">
            Visible en la tienda
        </label>
        <div class="fila-final">
            <a class="boton boton-borde" asp-controller="Panel" asp-action="Productos">Cancelar</a>
            <button class="boton" type="submit">Guardar</button>
        </div>
    </form>
</div>
