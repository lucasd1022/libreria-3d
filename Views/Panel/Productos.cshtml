@{
    ViewData["Title"] = "Productos";
}

<div class="contenedor seccion">
    <partial name="_PanelMenu" />
    <div class="encabezado">
        <h1 class="titulo">Productos</h1>
        <a class="boton" asp-controller="Panel" asp-action="NuevoProducto">Nuevo producto</a>
    </div>

    <form class="buscador" asp-controller="Panel" asp-action="Productos" method="get">
        <div class="fila-campo">
            <label class="campo-titulo" for="texto">Buscar</label>
            <input class="campo" id="texto" name="texto" type="search" value="@ViewBag.Texto">
        </div>
        <button class="boton" type="submit">Buscar</button>
    </form>

    @if (ViewBag.Productos.Count == 0)
    {
        <div class="vacio"><h2>No hay productos</h2></div>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Estado</th><th><span class="solo-lectores">Acciones</span></th></tr>
                </thead>
                <tbody>
                    @foreach (Producto producto in ViewBag.Productos)
                    {
                        <tr>
                            <td>@producto.Nombre</td>
                            <td>@(producto.Categoria ?? "—")</td>
                            <td>@Vistas.Precio(producto.Precio)</td>
                            <td class="@(producto.HayStock ? "" : "texto-error")">@producto.Stock</td>
                            <td><span class="etiqueta @(producto.Activo ? "etiqueta-exito" : "")">@(producto.Activo ? "Visible" : "Oculto")</span></td>
                            <td>
                                <div class="celda-acciones">
                                <a asp-controller="Panel" asp-action="EditarProducto" asp-route-id="@producto.ID">Editar</a>
                                <details class="confirmar">
                                    <summary class="boton-link boton-link-peligro">Eliminar</summary>
                                    <form asp-controller="Panel" asp-action="EliminarProducto" asp-route-id="@producto.ID" method="post">
                                        <p>¿Eliminar "@producto.Nombre"? No se puede deshacer.</p>
                                        <button class="boton boton-peligro boton-chico" type="submit">Sí, eliminar</button>
                                    </form>
                                </details>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
