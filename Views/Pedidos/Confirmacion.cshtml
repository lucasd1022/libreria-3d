@{
    Pedido pedido = ViewBag.Pedido;
    ViewData["Title"] = "¡Gracias por tu compra!";
}

<div class="contenedor seccion angosto">
    <div class="tarjeta">
        <h1 class="titulo">¡Gracias, @pedido.Nombre!</h1>
        <p>Recibimos tu pedido <strong>#@pedido.ID</strong> por un total de <strong>@Vistas.Precio(pedido.Total)</strong>.</p>
        <p>Te vamos a escribir a <strong>@pedido.Email</strong> para coordinar el pago y el envío.</p>
        <ul class="lista-datos">
            @foreach (var item in pedido.Items)
            {
                <li>@item.Cantidad × @item.Nombre <span class="derecha">@Vistas.Precio(item.Subtotal)</span></li>
            }
        </ul>
        <a class="boton" asp-controller="Productos" asp-action="Index">Volver al catálogo</a>
    </div>
</div>
