@{
    Producto producto = ViewBag.Producto;
    ViewData["Title"] = producto.Nombre;
}

<div class="contenedor seccion">
    <p class="migas">
        <a asp-controller="Productos" asp-action="Index">Productos</a>
        @if (producto.IDCategoria.HasValue)
        {
            <span>›</span> <a asp-controller="Productos" asp-action="Index" asp-route-categoria="@producto.IDCategoria">@producto.Categoria</a>
        }
    </p>

    <div class="columnas columnas-mitad">
        <div>
            <div class="producto-imagen producto-imagen-grande">
                <partial name="_ImagenProducto" model="producto" />
            </div>
        </div>
        <div>
            <h1 class="titulo">@producto.Nombre</h1>
            <p class="precio precio-grande">@Vistas.Precio(producto.Precio)</p>
            @if (!string.IsNullOrEmpty(producto.Descripcion))
            {
                <p class="texto-con-saltos">@producto.Descripcion</p>
            }

            @if (producto.HayStock)
            {
                <p class="texto-exito">Hay stock: @producto.Stock unidades</p>
                <form class="fila-formulario" asp-controller="Carrito" asp-action="Agregar" asp-route-id="@producto.ID" asp-route-volver="@ViewContext.AquiMismo()" method="post">
                    <label class="solo-lectores" for="cantidad">Cantidad</label>
                    <input class="campo campo-cantidad" id="cantidad" name="cantidad" type="number" value="1" min="1" max="@producto.Stock">
                    <button class="boton" type="submit">Agregar al carrito</button>
                </form>
                <p class="texto-suave nota-entrega">Retiralo sin cargo en @Tienda.DireccionCompleta@(Tienda.HaceEnvios ? $" o pedí envío a domicilio ({Tienda.TextoCostoEnvio})" : "").</p>
            }
            else
            {
                <p><span class="etiqueta etiqueta-error">Sin stock</span></p>
            }
        </div>
    </div>
</div>
