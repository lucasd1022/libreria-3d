@{
    ViewData["Title"] = "Catálogo";
    int? categoriaActual = ViewBag.Categoria;
}

<div class="container seccion">
    <div class="encabezado">
        <div>
            <h1 class="titulo">Catálogo</h1>
            <p class="texto-suave">@ViewBag.Productos.Count productos</p>
        </div>
    </div>

    <form class="buscador" asp-controller="Productos" asp-action="Index" method="get">
        <div class="form-field">
            <label class="form-label" for="texto">Buscar</label>
            <input class="form-control" id="texto" name="texto" type="search" value="@ViewBag.Texto" placeholder="Cuaderno, fibras, carpeta…">
        </div>
        <div class="form-field">
            <label class="form-label" for="categoria">Categoría</label>
            <select class="form-control" id="categoria" name="categoria">
                <option value="">Todas</option>
                @foreach (Categoria categoria in ViewBag.Categorias)
                {
                    <option value="@categoria.ID" selected="@(categoriaActual == categoria.ID)">@categoria.Nombre</option>
                }
            </select>
        </div>
        <button class="btn-solid theme-primary boton" type="submit">Buscar</button>
    </form>

    @if (ViewBag.Productos.Count == 0)
    {
        <div class="vacio">
            <h2>No encontramos productos</h2>
            <p>Probá con otra palabra o elegí otra categoría.</p>
            <a asp-controller="Productos" asp-action="Index">Ver todo el catálogo</a>
        </div>
    }
    else
    {
        <div class="grilla-productos">
            @foreach (Producto producto in ViewBag.Productos)
            {
                <partial name="_ProductoTarjeta" model="producto" />
            }
        </div>
    }
</div>
