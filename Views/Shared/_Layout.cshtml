<!doctype html>
<html lang="es">
<head>
    <partial name="_Head" />
</head>
<body>
    <header>
        <nav class="navbar md:navbar-expand menu-tienda">
            <div class="container">
                <a class="navbar-brand logo" asp-controller="Home" asp-action="Index"><span class="logo-letra">L</span>@Tienda.Nombre</a>
                <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon" aria-hidden="true"></span>
                </button>
                <dialog class="drawer drawer-end" tabindex="-1" id="menu" aria-labelledby="menu-titulo">
                    <div class="drawer-header">
                        <h5 class="drawer-title" id="menu-titulo">@Tienda.Nombre</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Cerrar"></button>
                    </div>
                    <div class="drawer-body">
                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="@ViewContext.ClaseLink("Productos")" aria-current="@ViewContext.Actual("Productos")" asp-controller="Productos" asp-action="Index">Catálogo</a></li>
                            <li class="nav-item"><a class="@ViewContext.ClaseLink("Home", "Contacto")" aria-current="@ViewContext.ActualAccion("Home", "Contacto")" asp-controller="Home" asp-action="Contacto">Contacto</a></li>
                            @if (User.EsAdministrador())
                            {
                                var pendientes = ViewContext.PedidosPendientes();
                                <li class="nav-item">
                                    <a class="@ViewContext.ClaseLink("Panel")" aria-current="@ViewContext.Actual("Panel")" asp-controller="Panel" asp-action="Pedidos">
                                        Panel @if (pendientes > 0) { <span class="badge contador">@pendientes</span> }
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                @{ var enCarrito = ViewContext.CantidadCarrito(); }
                                <a class="btn-solid theme-primary boton boton-acento" asp-controller="Carrito" asp-action="Index">
                                    Carrito @if (enCarrito > 0) { <span class="badge contador">@enCarrito</span> }
                                </a>
                            </li>
                        </ul>
                    </div>
                </dialog>
            </div>
        </nav>
    </header>

    <main>
        <partial name="_Avisos" />
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="md:col-6">
                    <p class="logo logo-claro"><span class="logo-letra">L</span>@Tienda.Nombre</p>
                    <p>Todo para estudiar, crear y organizarte.</p>
                </div>
                <div class="col-6 md:col-3">
                    <h4>Tienda</h4>
                    <a asp-controller="Productos" asp-action="Index">Catálogo</a>
                    <a asp-controller="Carrito" asp-action="Index">Carrito</a>
                    <a asp-controller="Home" asp-action="Contacto">Contacto</a>
                </div>
                <div class="col-6 md:col-3">
                    <h4>Administración</h4>
                    @if (User.EsAdministrador())
                    {
                        <a asp-controller="Panel" asp-action="Pedidos">Panel</a>
                        <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                            <button class="boton-link boton-link-claro" type="submit">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="IniciarSesion">Ingresar</a>
                    }
                </div>
            </div>
            <p class="copy">© @DateTime.Today.Year @Tienda.Nombre · Hecho en Argentina</p>
        </div>
    </footer>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>
</html>
