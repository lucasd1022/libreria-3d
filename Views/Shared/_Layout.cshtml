<!doctype html>
<html lang="es">
<head>
    <partial name="_Head" />
</head>
<body>
    <header class="menu-tienda">
        <div class="contenedor menu-fila">
            <a class="logo" asp-controller="Home" asp-action="Index"><span class="logo-letra">L</span>@Tienda.Nombre</a>
            <nav class="menu" aria-label="Menú principal">
                <a class="@ViewContext.ClaseLink("Productos")" aria-current="@ViewContext.Actual("Productos")" asp-controller="Productos" asp-action="Index">Productos</a>
                <a class="@ViewContext.ClaseLink("Home", "Contacto")" aria-current="@ViewContext.ActualAccion("Home", "Contacto")" asp-controller="Home" asp-action="Contacto">El local</a>
                @if (User.EsAdministrador())
                {
                    var pendientes = ViewContext.PedidosPendientes();
                    <a class="@ViewContext.ClaseLink("Panel")" aria-current="@ViewContext.Actual("Panel")" asp-controller="Panel" asp-action="Pedidos">
                        Panel @if (pendientes > 0) { <span class="contador">@pendientes</span> }
                    </a>
                }
                @{ var enCarrito = ViewContext.CantidadCarrito(); }
                <a class="boton boton-acento" asp-controller="Carrito" asp-action="Index">
                    Carrito @if (enCarrito > 0) { <span class="contador">@enCarrito</span> }
                </a>
            </nav>
        </div>
    </header>

    <main>
        <partial name="_Avisos" />
        @RenderBody()
    </main>

    <footer>
        <div class="contenedor">
            <div class="columnas columnas-pie">
                <div>
                    <p class="logo logo-claro"><span class="logo-letra">L</span>@Tienda.Nombre</p>
                    <p>@Tienda.DireccionCompleta</p>
                    @foreach (var horario in Tienda.Horarios)
                    {
                        <p class="pie-horario">@horario</p>
                    }
                </div>
                <div>
                    <h4>Tienda</h4>
                    <a asp-controller="Productos" asp-action="Index">Productos</a>
                    <a asp-controller="Carrito" asp-action="Index">Carrito</a>
                    <a asp-controller="Home" asp-action="Contacto">El local y contacto</a>
                </div>
                <div>
                    <h4>Administración</h4>
                    @if (User.EsAdministrador())
                    {
                        <a asp-controller="Panel" asp-action="Pedidos">Panel</a>
                        <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                            <button class="boton-link boton-link-claro" type="submit">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="IniciarSesion">Ingresar</a>
                    }
                </div>
            </div>
            <p class="copy">© @DateTime.Today.Year @Tienda.Nombre </p>
        </div>
    </footer>

</body>
</html>
