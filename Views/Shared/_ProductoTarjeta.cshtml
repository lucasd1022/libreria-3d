@model Producto
<article class="tarjeta tarjeta-compacta">
    <a class="marco-imagen" asp-controller="Productos" asp-action="Detalle" asp-route-id="@Model.ID" tabindex="-1">
        <partial name="_ImagenProducto" model="Model" />
    </a>
    <div class="tarjeta-cuerpo">
        @if (!string.IsNullOrEmpty(Model.Categoria))
        {
            <span class="etiqueta">@Model.Categoria</span>
        }
        <h3 class="tarjeta-titulo"><a asp-controller="Productos" asp-action="Detalle" asp-route-id="@Model.ID">@Model.Nombre</a></h3>
        <div class="tarjeta-pie">
            <strong class="texto-destacado">@Vistas.Precio(Model.Precio)</strong>
            @if (Model.HayStock)
            {
                <form asp-controller="Carrito" asp-action="Agregar" asp-route-id="@Model.ID" asp-route-volver="@ViewContext.AquiMismo()" method="post">
                    <button class="boton boton-chico" type="submit">Agregar</button>
                </form>
            }
            else
            {
                <span class="etiqueta etiqueta-roja">Sin stock</span>
            }
        </div>
    </div>
</article>
