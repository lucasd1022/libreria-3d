<%- include('../partials/head') %>
<%- include('../partials/header') %>
<form method="post" action="/admin/login" class="formulario formulario--angosto panel">
  <h1>Panel de administración</h1>
  <% if (error) { %><div class="alerta alerta--error"><%= error %></div><% } %>
  <label>Usuario<input name="usuario" required autocomplete="username"></label>
  <label>Contraseña<input type="password" name="password" required autocomplete="current-password"></label>
  <button class="btn btn--grande">Ingresar</button>
</form>
<%- include('../partials/footer') %>
