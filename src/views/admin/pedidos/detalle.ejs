<%- include('../../partials/head') %>
<%- include('../../partials/header') %>
<%- include('../../partials/admin-nav') %>

<h1>Pedido #<%= pedido.id %></h1>

<div class="checkout">
  <div class="panel">
    <h2>Cliente</h2>
    <ul class="lista-simple">
      <li><strong><%= pedido.nombre %></strong></li>
      <li><a href="mailto:<%= pedido.email %>"><%= pedido.email %></a></li>
      <% if (pedido.telefono) { %><li>Tel: <%= pedido.telefono %></li><% } %>
      <% if (pedido.direccion) { %><li>Envío: <%= pedido.direccion %></li><% } %>
      <% if (pedido.notas) { %><li>Notas: <%= pedido.notas %></li><% } %>
      <li>Fecha: <%= pedido.creado_en %></li>
    </ul>
    <form method="post" action="/admin/pedidos/<%= pedido.id %>/estado?_method=PUT" class="form-linea">
      <select name="estado">
        <% estados.forEach(function (e) { %>
          <option value="<%= e %>" <%= pedido.estado === e ? 'selected' : '' %>><%= e %></option>
        <% }) %>
      </select>
      <button class="btn">Cambiar estado</button>
    </form>
  </div>
  <div class="panel">
    <h2>Productos</h2>
    <table class="tabla">
      <thead><tr><th>Producto</th><th>Cant.</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% pedido.items.forEach(function (i) { %>
          <tr><td><%= i.nombre %></td><td><%= i.cantidad %></td><td><%= precio(i.precio_unitario * i.cantidad) %></td></tr>
        <% }) %>
      </tbody>
      <tfoot><tr><th colspan="2">Total</th><th><%= precio(pedido.total) %></th></tr></tfoot>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
