<%- include('../../partials/head') %>
<%- include('../../partials/header') %>
<%- include('../../partials/admin-nav') %>

<h1><%= titulo %></h1>

<% const editando = Boolean(producto.id); %>
<form method="post" action="/admin/productos<%= editando ? '/' + producto.id + '?_method=PUT' : '' %>" class="formulario">
  <% if (errores.length) { %>
    <div class="alerta alerta--error"><ul><% errores.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <label>Nombre *<input name="nombre" required value="<%= producto.nombre || '' %>"></label>
  <label>Descripción<textarea name="descripcion" rows="4"><%= producto.descripcion || '' %></textarea></label>
  <div class="form-fila">
    <label>Precio (ARS) *<input type="number" name="precio" min="0" step="1" required value="<%= producto.precio ?? '' %>"></label>
    <label>Stock *<input type="number" name="stock" min="0" step="1" required value="<%= producto.stock ?? 0 %>"></label>
  </div>
  <label>Categoría
    <select name="categoria_id">
      <option value="">Sin categoría</option>
      <% categorias.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= producto.categoria_id === c.id ? 'selected' : '' %>><%= c.nombre %></option>
      <% }) %>
    </select>
  </label>
  <label>URL de la imagen<input name="imagen" placeholder="/img/productos/mi-foto.jpg" value="<%= producto.imagen || '' %>"></label>
  <label class="check"><input type="checkbox" name="activo" value="1" <%= producto.activo ? 'checked' : '' %>> Visible en la tienda</label>
  <div class="acciones">
    <a href="/admin/productos" class="btn btn--secundario">Cancelar</a>
    <button class="btn">Guardar</button>
  </div>
</form>

<%- include('../../partials/footer') %>
