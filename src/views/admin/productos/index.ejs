<%- include('../../partials/head') %>
<%- include('../../partials/header') %>
<%- include('../../partials/admin-nav') %>

<div class="titulo-acciones">
  <h1>Productos</h1>
  <a href="/admin/productos/nuevo" class="btn">Nuevo producto</a>
</div>

<table class="tabla">
  <thead><tr><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Estado</th><th></th></tr></thead>
  <tbody>
    <% productos.forEach(function (p) { %>
      <tr>
        <td><%= p.nombre %></td>
        <td><%= p.categoria_nombre || '—' %></td>
        <td><%= precio(p.precio) %></td>
        <td><%= p.stock %></td>
        <td><%= p.activo ? 'Visible' : 'Oculto' %></td>
        <td class="celda-acciones">
          <a href="/admin/productos/<%= p.id %>/editar">Editar</a>
          <form method="post" action="/admin/productos/<%= p.id %>?_method=DELETE" data-confirmar="¿Eliminar <%= p.nombre %>?">
            <button class="btn btn--texto">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../../partials/footer') %>
