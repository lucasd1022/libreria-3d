<%- include('../partials/head') %>
<%- include('../partials/header') %>

<h1>Tu carrito</h1>

<% if (!lineas.length) { %>
  <p class="vacio">Tu carrito está vacío. <a href="/productos">Ver catálogo</a></p>
<% } else { %>
  <table class="tabla">
    <thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th></th></tr></thead>
    <tbody>
      <% lineas.forEach(function (l) { %>
        <tr>
          <td><a href="/productos/<%= l.producto.slug %>"><%= l.producto.nombre %></a></td>
          <td><%= precio(l.producto.precio) %></td>
          <td>
            <form method="post" action="/carrito/<%= l.producto.id %>?_method=PUT" class="form-linea">
              <input type="number" name="cantidad" value="<%= l.cantidad %>" min="0" max="<%= l.producto.stock %>" aria-label="Cantidad" data-autosubmit>
              <noscript><button class="btn btn--chico">Actualizar</button></noscript>
            </form>
          </td>
          <td><%= precio(l.subtotal) %></td>
          <td>
            <form method="post" action="/carrito/<%= l.producto.id %>?_method=DELETE">
              <button class="btn btn--texto" aria-label="Quitar <%= l.producto.nombre %>">Quitar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot><tr><th colspan="3">Total</th><th colspan="2"><%= precio(total) %></th></tr></tfoot>
  </table>
  <div class="acciones">
    <a href="/productos" class="btn btn--secundario">Seguir comprando</a>
    <a href="/checkout" class="btn btn--grande">Finalizar compra</a>
  </div>
<% } %>

<%- include('../partials/footer') %>
