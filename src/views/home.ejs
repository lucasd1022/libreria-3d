<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <h1>Todo para estudiar, crear y organizarte</h1>
  <p>Cuadernos, útiles escolares, arte y oficina. Enviamos a todo el país.</p>
  <a href="/productos" class="btn btn--grande">Ver catálogo</a>
</section>

<section>
  <h2>Categorías</h2>
  <div class="categorias">
    <% categorias.forEach(function (c) { %>
      <a class="chip" href="/productos?categoria=<%= c.slug %>"><%= c.nombre %></a>
    <% }) %>
  </div>
</section>

<section>
  <h2>Novedades</h2>
  <div class="grilla">
    <% destacados.forEach(function (p) { %><%- include('partials/tarjeta-producto', { p }) %><% }) %>
  </div>
</section>

<%- include('partials/footer') %>
