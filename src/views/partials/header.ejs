<header class="header">
  <div class="contenedor header__fila">
    <a href="/" class="logo"><%= tienda.nombre %></a>
    <nav class="nav">
      <a href="/productos" class="<%= rutaActual.startsWith('/productos') ? 'activo' : '' %>">Catálogo</a>
      <a href="/contacto" class="<%= rutaActual === '/contacto' ? 'activo' : '' %>">Contacto</a>
      <% if (esAdmin) { %><a href="/admin">Admin</a><% } %>
      <a href="/carrito" class="carrito-link">Carrito<% if (cantidadCarrito) { %> <span class="badge"><%= cantidadCarrito %></span><% } %></a>
    </nav>
  </div>
</header>
<main class="contenedor">
  <% mensajes.forEach(function (m) { %>
    <div class="alerta alerta--<%= m.tipo %>"><%= m.mensaje %></div>
  <% }) %>
