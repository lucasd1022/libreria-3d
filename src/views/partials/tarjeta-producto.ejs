<article class="producto">
  <a href="/productos/<%= p.slug %>" class="producto__imagen">
    <% if (p.imagen) { %>
      <img src="<%= p.imagen %>" alt="<%= p.nombre %>" loading="lazy">
    <% } else { %>
      <span class="placeholder" aria-hidden="true"><%= p.nombre.charAt(0) %></span>
    <% } %>
  </a>
  <div class="producto__info">
    <% if (p.categoria_nombre) { %><span class="etiqueta"><%= p.categoria_nombre %></span><% } %>
    <h3><a href="/productos/<%= p.slug %>"><%= p.nombre %></a></h3>
    <div class="producto__pie">
      <strong><%= precio(p.precio) %></strong>
      <form method="post" action="/carrito">
        <input type="hidden" name="productoId" value="<%= p.id %>">
        <button class="btn" <%= p.stock > 0 ? '' : 'disabled' %>><%= p.stock > 0 ? 'Agregar' : 'Sin stock' %></button>
      </form>
    </div>
  </div>
</article>
