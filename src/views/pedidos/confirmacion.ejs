<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="panel">
  <h1>¡Gracias, <%= pedido.nombre %>!</h1>
  <p>Recibimos tu pedido <strong>#<%= pedido.id %></strong> por un total de <strong><%= precio(pedido.total) %></strong>.</p>
  <p>Te vamos a escribir a <strong><%= pedido.email %></strong> para coordinar el pago y el envío.</p>
  <ul class="lista-simple">
    <% pedido.items.forEach(function (i) { %>
      <li><%= i.cantidad %> × <%= i.nombre %> — <%= precio(i.precio_unitario * i.cantidad) %></li>
    <% }) %>
  </ul>
  <a href="/productos" class="btn">Volver al catálogo</a>
</div>

<%- include('../partials/footer') %>
