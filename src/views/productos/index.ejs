<%- include('../partials/head') %>
<%- include('../partials/header') %>

<h1>Catálogo</h1>

<form class="filtros" method="get" action="/productos">
  <input type="search" name="q" placeholder="Buscar productos…" value="<%= filtro.q %>">
  <select name="categoria" data-autosubmit>
    <option value="">Todas las categorías</option>
    <% categorias.forEach(function (c) { %>
      <option value="<%= c.slug %>" <%= filtro.categoria === c.slug ? 'selected' : '' %>><%= c.nombre %></option>
    <% }) %>
  </select>
  <button class="btn">Buscar</button>
</form>

<% if (productos.length) { %>
  <div class="grilla">
    <% productos.forEach(function (p) { %><%- include('../partials/tarjeta-producto', { p }) %><% }) %>
  </div>
<% } else { %>
  <p class="vacio">No encontramos productos con esos filtros.</p>
<% } %>

<%- include('../partials/footer') %>
